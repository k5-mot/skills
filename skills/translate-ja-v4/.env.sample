# Docling Serve。ParseStageで使用する。
DOCLING_SERVER_URL="http://docling:5001"
DOCLING_API_KEY="replace-with-docling-key"

# LibreTranslate。--translator defaultのTranslateStageで使用する。
LIBRETRANSLATE_URL="http://libretranslate:5000"
# 認証を有効にした環境だけ設定する。
# LIBRETRANSLATE_API_KEY="replace-with-libretranslate-key"

# OpenAI互換API。StructureStage、ReviewStage、--translator llm、Qdrant ingestで使用する。
OPENAI_BASE_URL="http://litellm:4000/v1"
OPENAI_API_KEY="replace-with-openai-key"
OPENAI_MODEL="replace-with-model-name"
# TimeoutとRetryはrun_pipeline.pyのCLI引数で指定する。

# Langfuse tracing。両keyを設定した場合だけ全LLM/VLM callを記録する。
# self-hosted環境ではLANGFUSE_OTEL_HOSTをそのendpointへ変更する。
# LANGFUSE_PUBLIC_KEY="pk-lf-replace-with-public-key"
# LANGFUSE_SECRET_KEY="sk-lf-replace-with-secret-key"
# LANGFUSE_OTEL_HOST="http://langfuse:3000"

# Qdrant RAG。--review-ragとingest_qdrant.pyで使用する。
QDRANT_URI="http://qdrant:6333"
QDRANT_API_KEY="replace-with-qdrant-key"
QDRANT_COLLECTION="domain-documents"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
