# ログ設定。level名だけを色付きで表示する。
LOG_LEVEL="DEBUG"

# Docling Serve。英日両PDFのParseStageで使用する。
DOCLING_SERVER_URL="http://docling:5001"
DOCLING_API_KEY="replace-with-docling-key"

# OpenAI互換API。AlignmentStageとReviewStageで使用する。
OPENAI_BASE_URL="http://litellm:4000/v1"
OPENAI_API_KEY="replace-with-openai-key"
OPENAI_MODEL="replace-with-model-name"
OPENAI_STRUCTURED_METHOD="json_mode"

# Langfuse tracing。両keyを設定した場合だけLLM callを記録する。
# LANGFUSE_PUBLIC_KEY="pk-lf-replace-with-public-key"
# LANGFUSE_SECRET_KEY="sk-lf-replace-with-secret-key"
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# LANGFUSE_TRACING_ENVIRONMENT="development"

# Qdrant RAG。--review-ragを指定した場合だけ使用する。
QDRANT_URI="http://qdrant:6333"
QDRANT_API_KEY="replace-with-qdrant-key"
QDRANT_COLLECTION="domain-documents"
QDRANT_TOP_K="3"
QDRANT_VECTOR_NAME=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
