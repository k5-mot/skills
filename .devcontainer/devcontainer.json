// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "Ubuntu",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {},
    "ghcr.io/rocker-org/devcontainer-features/pandoc:1": {}
    // "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],
  // Use 'postCreateCommand' to run commands after the container is created.
  "initializeCommand": "echo $(powershell.exe -Command 'echo $env:UserName' | tr -d '\r')",
  "postCreateCommand": "bash ./.devcontainer/postCreateCommand.sh",
  "postStartCommand": "uname -a",
  "mounts": [
    // Share the "AWS" creadentials with Windows or WSL2.
    // "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
    // Share the "Azure" creadentials with Windows or WSL2.
    // "source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind,consistency=cached",
    // Share the "Claude Code" settings and creadentials with Windows or WSL2.
    // "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    // Share the "Codex CLI" settings and credentials with Windows or WSL2.
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    // Store the "Serena" MCP server cache.
    "source=${localWorkspaceFolderBasename}-serena-cache,target=${containerWorkspaceFolder}/.serena/cache,type=volume",
    // Store the "pnpm" cache as a Docker volume.
    "source=${localWorkspaceFolderBasename}-pnpm-cache,target=${containerWorkspaceFolder}/.pnpm-store,type=volume",
    // Store the "uv" cache as a Docker volume.
    "source=${localWorkspaceFolderBasename}-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        // ------------------------------
        // Coding Agents
        // ------------------------------
        "github.copilot", // GitHub Copilot
        "github.copilot-chat", // GitHub Copilot Chat
        "openai.chatgpt", // OpenAI Codex CLI
        // "anthropic.claude-code", // Anthropic Claude Code
        // "saoudrizwan.claude-dev", // Cline
        // "ZooCodeOrganization.zoo-code", // Zoo Code
        // ------------------------------
        // Utility
        // ------------------------------
        // "foam.foam-vscode", // Foam; Note taking
        // "github.remotehub", // GitHub Repositories
        // "github.codespaces", // GitHub Codespaces
        // "github.vscode-github-actions", // GitHub Actions
        // "github.vscode-pull-request-github", // GitHub Pull Requests
        // "gitlab.gitlab-workflow", // GitLab Workflow
        // ------------------------------
        // Language support for Frontend Development
        // ------------------------------
        "voidzero.vite-plus-extension-pack", // Vite-Plus
        "oxc.oxc-vscode", // Linter/Formatter
        "vitest.explorer", // Test
        "xabikos.JavaScriptSnippets", // Code Snippets
        "yoavbls.pretty-ts-errors", // Pretty Error messages for Typescript
        "crystal-spider.jsdoc-generator", // JSDoc generator
        "formulahendry.auto-rename-tag", // Auto rename tag for HTML
        "formulahendry.auto-close-tag", // Auto close tag for HTML
        "dsznajder.es7-react-js-snippets", // Code Snippets for React.js
        "wix.vscode-import-cost", // Package Size Checker for npm
        // "PulkitGangwar.nextjs-snippets", // Code Snippets for Next.js
        // "nextnav.nextnav", // Route Visualizer for Next.js
        // ------------------------------
        // Language support for Backend Development
        // ------------------------------
        "ms-python.python", // Python
        "ms-python.vscode-pylance", // Python Language Server
        "ms-python.debugpy", // Python Debugger
        "ms-python.vscode-python-envs", // Python Environment Manager
        "batisteo.vscode-django", // Django
        "njpwerner.autodocstring", // Docstring
        "kevinrose.vsc-python-indent", // Indent
        "charliermarsh.ruff", // Linter/Formatter
        // ------------------------------
        // Language support
        // ------------------------------
        "davidanson.vscode-markdownlint", // Markdown Linter
        "yzhang.markdown-all-in-one", // Markdown Completion
        // "shd101wyy.markdown-preview-enhanced", // Markdown Preview Enhanced
        "bierner.markdown-preview-github-styles", // Markdown Preview GitHub Styles
        "bierner.markdown-mermaid", // Mermaid
        "tamasfe.even-better-toml", // TOML
        "redhat.vscode-yaml" // YAML
      ],
      "settings": {
        "telemetry.telemetryLevel": "off",
        "chat.titleBar.signIn.enabled": false,
        "chat.titleBar.openInAgentsWindow.enabled": false,
        "extensions.ignoreRecommendations": true
      }
    }
  }
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
