### OpenAI互換API（StructureStage、ReviewStage、LLM翻訳で使用）
OPENAI_BASE_URL="http://litellm:4000"
OPENAI_API_KEY="sk-litellm-master-key"
OPENAI_MODEL="google/gemma4:31b"

### Docling Serve（ParseStageで使用）
DOCLING_SERVER_URL="http://docling:5001"
DOCLING_API_KEY="sk-docling-serve-api-key"

### Langfuse連携（任意）
LANGFUSE_PUBLIC_KEY="pk-lf-langfuse-project-public-key"
LANGFUSE_SECRET_KEY="sk-lf-langfuse-project-secret-key"
LANGFUSE_OTEL_HOST="http://langfuse-web:3000"

### Qdrant RAG（ReviewStageで--review-rag指定時に使用）
QDRANT_API_KEY="sk-qdrant-api-key"
QDRANT_URI="http://qdrant:6333"

### Obsidian CouchDB読み取り（obsidian-couchdb-readで使用）
OBSIDIAN_COUCHDB_DOMAIN="https://couchdb.example.com"
OBSIDIAN_COUCHDB_USER="readonly-user"
OBSIDIAN_COUCHDB_PASSWORD="readonly-password"
